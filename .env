# CtrlRelay Configuration

# --- Auth ---
TELEGRAM_TOKEN=8656575536:AAG4_JBydqv2_-kxxKHRW_rfqSNZ2h4AKY0
ALLOWED_CHAT_IDS=8253052066   # Comma-separated Telegram chat IDs (e.g., 123456789,987654321)

# --- Power Settings ---
VOID_POWER_TIMER=false        # Show cancel window before shutdown/restart/sleep
POWER_TIMER_WAIT=90        # Seconds to wait before executing power command
POWER_MANAGEMENT=true      # Enable /processes, /kill, /launch, /setaudio
# --- System ---
PROCESS_MANAGEMENT=true      # Enable /processes, /kill, /launch, /setaudio
SCREENSHOT_QUALITY=85        # JPEG quality 1-100
MONITOR_INDEX=0              # Which monitor to screenshot (0 = primary)

# --- Files ---
ALLOWED_PATHS=C:/Users,D:/     # Comma-separated, restricts /ls and /upload
MAX_UPLOAD_SIZE=48             # Max file size in MB (Telegram bot limit is 50MB)
BLOCKED_EXTENSIONS=.exe,.bat,.ps1,.msi,.cmd,.vbs,.reg
DOWNLOAD_PATH=C:/Users/Public/Downloads/CtrlRelay

# --- Input ---
RUN_COMMAND_ENABLED=true     # Enable /run (shell command execution)
TYPE_ENABLED=true            # Enable /type (remote keyboard input)

# --- Logging  ---
LOG_LEVEL=INFO               # DEBUG, INFO, ERROR
LOG_FILE=ctrlrelay.log      
